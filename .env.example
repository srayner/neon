# Database connection
DATABASE_URL=postgresql://user:password@localhost:5432/neon

# Security - REQUIRED in production (no defaults)
JWT_SECRET=your-secure-jwt-secret-min-32-characters
AGENT_SECRET=your-shared-agent-registration-secret

# Optional
SERVER_NAME=neon-master

# Backups browser - root directory for backup file browsing
BACKUP_ROOT=/path/to/backups

# Alerts - self-hosted ntfy server for push notifications
NTFY_URL=https://ntfy.example.com
NTFY_TOPIC=neon
NTFY_TOKEN=tk_your-ntfy-access-token
