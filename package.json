{
  "name": "neon",
  "version": "0.5.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev -p 3005",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "build:shared": "npm run build -w @neon/shared",
    "build:agent": "npm run build:shared && npm run build -w @neon/agent",
    "agent:dev": "npm run build:shared && dotenv -e packages/agent/.env -- npm run dev -w @neon/agent",
    "agent:start": "dotenv -e packages/agent/.env -- npm run start -w @neon/agent",
    "agent:bundle": "npm run build:shared && npm run bundle -w @neon/agent",
    "docker:build:agent": "npm run agent:bundle && docker build -t neon-agent:latest -f packages/agent/Dockerfile .",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@types/dockerode": "^4.0.0",
    "@types/node-cron": "^3.0.11",
    "dockerode": "^5.0.1",
    "jose": "^6.1.3",
    "lucide-react": "^0.562.0",
    "next": "15.5.29",
    "node-cron": "^4.2.1",
    "prisma": "^6.19.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.6.0",
    "systeminformation": "^5.30.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@prisma/config": {
      "effect": "^3.22.5",
      "deepmerge-ts": "^8.0.0"
    },
    "next": {
      "postcss": "^8.5.23"
    }
  }
}
