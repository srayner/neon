# Required
SERVER_NAME=my-server-01
MASTER_URL=https://neon.example.com
AGENT_SECRET=your-agent-secret

# Docker socket access (get GID with: stat -c '%g' /var/run/docker.sock)
DOCKER_GID=999

# Optional (values shown are defaults)
METRICS_INTERVAL=300
CONTAINERS_INTERVAL=900
HEARTBEAT_INTERVAL=60
BUFFER_ENABLED=true
BUFFER_MAX_SIZE=100
